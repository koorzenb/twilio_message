# Email Configuration (New - Primary notification method)
EMAIL_PROVIDER=gmail
# For Gmail, Outlook, Yahoo, or iCloud, just set EMAIL_PROVIDER
# For custom SMTP, set SMTP_HOST and SMTP_PORT instead

# Custom SMTP Configuration (only needed if not using EMAIL_PROVIDER)
# SMTP_HOST=your.smtp.server.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Email Credentials (Required)
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here
SENDER_EMAIL=your.email@gmail.com
SENDER_NAME=IRCC Website Monitor

# Email Recipients (Required)
RECIPIENT_EMAIL=recipient@example.com
# TEST_EMAIL_RECIPIENT=test@example.com  # Optional: for testing email client

# Legacy Twilio Configuration (Deprecated - will be removed)
# MY_PHONE_NUMBER=your_actual_phone_number_here
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_here