# =================================================================
# IRCC Website Monitor - Email Configuration
# =================================================================

# Email Provider Configuration (Choose one method)
# Method 1: Use predefined provider (Recommended)
EMAIL_PROVIDER=gmail
# Supported providers: gmail, outlook, yahoo, icloud

# Method 2: Custom SMTP server (Advanced users)
# Uncomment and configure these if not using EMAIL_PROVIDER
# SMTP_HOST=your.smtp.server.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# =================================================================
# Email Authentication (Required)
# =================================================================

# Your email credentials
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Sender information
SENDER_EMAIL=your.email@gmail.com
SENDER_NAME=IRCC Website Monitor

# =================================================================
# Email Recipients (Required)
# =================================================================

# Primary recipient (Required)
RECIPIENT_EMAIL=recipient@example.com

# Additional recipients (Optional - comma separated)
# ADDITIONAL_RECIPIENTS=user2@example.com,user3@example.com

# Test recipient for email client testing (Optional)
# TEST_EMAIL_RECIPIENT=test@example.com

# =================================================================
# Gmail Setup Instructions
# =================================================================
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use your Gmail address as EMAIL_USERNAME and SENDER_EMAIL
# 4. Use the generated App Password as EMAIL_PASSWORD (not your regular password)
# 5. Set EMAIL_PROVIDER=gmail

# =================================================================
# Application Settings (Optional)
# =================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Cache directory for website data
# CACHE_DIR=data